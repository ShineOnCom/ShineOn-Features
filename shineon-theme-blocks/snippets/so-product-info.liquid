{% assign pt_so_metafields = product.metafields.shineon %}
{% assign pt_metafields = pt_so_metafields.schema_v2.value | default: pt_so_metafields.schema_v2 %}
{% assign pt_id = 'pt_' | append: pt_metafields.product_template_id %}
{% assign shop_pt_id_obj = shop.metafields.shineon[pt_id].value | default: shop.metafields.shineon[pt_id] %}
{% assign product_cfs = shop_pt_id_obj.custom_fields %}

{% assign addons = product.metafields.shineon.addons.value | default: product.metafields.shineon.addons %}
{% assign product_addons = addons.items | where: 'type', 'product_addon' | sort: 'order' %}

<script type="application/json" id="product-info">
  {
    "shop_info": {
      "sectionID": {{ section.id | json }},
      "shop_money_format": {{ shop.money_format | json }},
      "shop_currency": {{ shop.currency | json }}
    },
    {% if product_addons.size > 0 %}
    "upsells": {
      "product_addons": {{ product_addons | json }},
      "addons_products": {
        {% for product_addon in product_addons %}
          {% assign addon_schema_obj = all_products[product_addon.handle].metafields.shineon.schema_v2.value
            | default: all_products[product_addon.handle].metafields.shineon.schema_v2
          %}
          {% assign pt_id = 'pt_' | append: addon_schema_obj.product_template_id %}
          {% assign addon_pt_id_obj = shop.metafields.shineon[pt_id].value | default: shop.metafields.shineon[pt_id] %}
          {% assign addon_cf_obj = addon_pt_id_obj.custom_fields %}
          "{{ product_addon.handle }}": {
            {% if addon_cf_obj.size > 0 %}
              "addon_cfs": {
                {% for addon_cf_id in addon_cf_obj %}
                  {% assign addon_shop_cf = shop.metafields.shineon[addon_cf_id.key].value
                    | default: shop.metafields.shineon[addon_cf_id.key]
                  %}
                  "{{ addon_cf_id.key }}": {{ addon_shop_cf | json }}{% unless forloop.last %},{% endunless %}
                {% endfor %}
              },
            {% endif %}
            "product": {{ all_products[product_addon.handle] | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }
    },
    {% endif %}
    "product": {{ product | json }},
    "product_metafields": {{ product.metafields.shineon | json }},
    "selected_variant": {{ product.selected_or_first_available_variant | json }},
    "variant_metafields": {
      {% for variant in product.variants %}
        "{{ variant.id }}": {
          "options": {{ variant.options | json }},
          "metal": {{ variant.metafields.shineon.metal | json }},
          "shape": {{ variant.metafields.shineon.shape | json }},
          "engravable": {{ variant.metafields.shineon.engravable | json }},
          "engravings": {{ variant.metafields.shineon.engravings | json }},
          "uploadable": {{ variant.metafields.shineon.uploadable | json }},
          "schema_v2": {{ variant.metafields.shineon.schema_v2.value | default: variant.metafields.shineon.schema_v2 | json }},
          "transformations_filenames_json": {{ variant.metafields.shineon.transformations_filenames_json.value | json }},
          "transformations_json": {{ variant.metafields.shineon.transformations_json.value | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    },
    "product_url": {{ product.url | json }},
    "options_with_values": {{ product.options_with_values | json }},
    "variant_id_input": "input[name='id']",
    "trigger_selector": {{ trigger_selector | json }},
    "shop_pt_id_obj": {{ shop_pt_id_obj | json }},
    "shop_cf": {
      {% for cf in product_cfs %}
        "{{ cf.key }}": {{ shop.metafields.shineon[cf.key].value
          | default: shop.metafields.shineon[cf.key] | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    },
    "additions": {
      "mapbox": {
        "access_token": {{ mapbox_access_token | default: "pk.eyJ1IjoiYWxla3NoaW5lb24iLCJhIjoiY202ejZiYjZxMDFnZjJrcXM3b2F4OTI1ZiJ9.OuSSAJIvxBUncZsIa4f9dg" | json }}
      },
      "chains": {
        "left": {
          "stainless": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-left.png?v=1747998188",
          "gold": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-left-gold.png?v=1747998188"
        },
        "right": {
          "stainless": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-right.png?v=1747998188",
          "gold": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-right-gold.png?v=1747998188"
        },
        "vertical": {
          "stainless": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-vertical-stainless.png?v=1748261178",
          "gold": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-vertical-gold.png?v=1748261178",
          "multiple": {
            "2" : {
              "stainless": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-vertical-multiple-stainless-2.png?v=1748439778",
              "gold": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-vertical-multiple-gold-2.png?v=1748261178"
            },
            "3" : {
              "stainless": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-vertical-multiple-stainless-3.png?v=1748261178",
              "gold": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-vertical-multiple-gold-3.png?v=1748261178"
            },
            "4" : {
              "stainless": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-vertical-multiple-stainless-4.png?v=1748261178",
              "gold": "https://cdn.shopify.com/s/files/1/0077/2420/4096/files/so-chain-vertical-multiple-gold-4.png?v=1748261178"
            }
          }
        }
      },
      "engraving": {
        "font":{
          "family":"Tangerine, serif",
          "url":["https://fonts.gstatic.com/s/tangerine/v17/IurY6Y5j_oScZZow4VOxCZZM.woff2"],
          "size":"136px",
          "line-height":"1",
          "weight":"700",
          "multiplier": 1.7
        },
        "shapes": {
          "dogtag": {
            "imgSrc": {
              "stainless": "https://cdn.shopify.com/s/files/1/0666/7891/5376/files/dog-tag-silver-h.png?v=1749129375",
              "gold": "https://cdn.shopify.com/s/files/1/0666/7891/5376/files/dog-tag-gold-h.png?v=1749129375"
            },
            "zone":{
              "width":1000,
              "height":504,
              "x":552,
              "y":252,
              "zoneWidth":635,
              "zoneHeight":329
            }
          },
          "circle": {
              "imgSrc": {
                "stainless": "https://cdn.shopify.com/s/files/1/0666/7891/5376/files/circle-silver-v.png?v=1750336951",
                "gold": "https://cdn.shopify.com/s/files/1/0666/7891/5376/files/circle-gold-v.png?v=1750336985"
              },
              "zone": {
                "width":1000,
                "height":1000,
                "x":490,
                "y":650,
                "zoneWidth":450,
                "zoneHeight":300
              }
          },
          "heart": {
              "imgSrc":{
                "stainless": "https://cdn.shopify.com/s/files/1/0666/7891/5376/files/heart-silver-v.png?v=1750250887",
                "gold": "https://cdn.shopify.com/s/files/1/0666/7891/5376/files/heart-gold-v.png?v=1750250887"
              },
              "zone": {
                "width":1000,
                "height":1000,
                "x":490,
                "y":600,
                "zoneWidth":500,
                "zoneHeight":330
              }
          },
          "cross": {
              "imgSrc":{
                "stainless": "https://cdn.shopify.com/s/files/1/0666/7891/5376/files/Cross_1000_1000.jpg?v=1753799816",
                "gold": "https://cdn.shopify.com/s/files/1/0666/7891/5376/files/Cross_Gold_1000_1000.jpg?v=1753799804"
              },
              "zone": {
                "width":1000,
                "height":1000,
                "x":695,
                "y":500,
                "zoneWidth":480,
                "zoneHeight":80
              },
              "font":{
                "family":"Courgette",
                "url":["http://fonts.gstatic.com/s/courgette/v4/2YO0EYtyE9HUPLZprahpZA.ttf"],
                "size":"136px",
                "line-height":"1",
                "weight":"700",
                "multiplier": 0.98,
                "zone": {
                  "x":710,
                  "y":500,
                  "zoneWidth":450,
                  "zoneHeight":70,
                  "textAlign": "right"
                }
              }
          }
        }
      }
    }
  }
</script>
